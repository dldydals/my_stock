"use client";
import React, { useState, useMemo, useEffect } from "react";
import {
  TrendingUp,
  TrendingDown,
  DollarSign,
  PieChart as PieChartIcon,
  Activity,
  Wallet,
  Calendar,
  ArrowUpRight,
  ArrowDownRight,
  Layers,
  ChevronRight,
  MoreHorizontal,
} from "lucide-react";
import {
  PieChart,
  Pie,
  Cell,
  Tooltip,
  ResponsiveContainer,
  Legend,
} from "recharts";

/**
 * 데이터 설정 영역
 * (기존 데이터 유지)
 */
