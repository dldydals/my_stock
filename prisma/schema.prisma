generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id           Int      @id @default(autoincrement())
  ticker       String   @unique
  name         String
  quantity     Int      @default(0)
  avgPrice     Float    @default(0) @map("avg_price")
  currentPrice Float    @default(0) @map("current_price")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("assets")
}

model Transaction {
  id                  Int             @id @default(autoincrement())
  ticker              String
  type                TransactionType
  quantity            Int
  price               Float
  fee                 Float           @default(0)
  tradeDate           DateTime        @map("trade_date")
  name                String          @default("")
  parentTransactionId Int?            @map("parent_transaction_id")
  realizedProfit      Float?          @map("realized_profit")
  remainingQuantity   Int             @default(0) @map("remaining_quantity")

  @@map("transactions")
}

model Dividend {
  id           Int      @id @default(autoincrement())
  ticker       String
  amount       Float
  tax          Float    @default(0)
  receivedDate DateTime @map("received_date")

  @@map("dividends")
}

model CashAccount {
  id        Int      @id @default(autoincrement())
  type      String   @unique
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cash_accounts")
}

model DailyReport {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @default(now())
  content   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("daily_reports")
}

model Watchlist {
  id        Int      @id @default(autoincrement())
  ticker    String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("watchlist")
}

enum TransactionType {
  BUY
  SELL
}

// 기존 모델들 아래에 추가하세요

model DailyStockPrice {
  // 복합키 구성을 위해 ID는 따로 두지 않고 ticker와 date 조합을 사용합니다.
  ticker    String   @db.VarChar(20)
  date      DateTime @db.Date // 시간 없이 날짜만 저장
  
  open      Decimal  @db.Decimal(10, 2) // 시가
  high      Decimal  @db.Decimal(10, 2) // 고가
  low       Decimal  @db.Decimal(10, 2) // 저가
  close     Decimal  @db.Decimal(10, 2) // 종가 (가장 중요)
  volume    BigInt   // 거래량 (주식수는 21억 넘을 수 있으니 BigInt)
  
  // 보조 지표 (선택사항 - 미리 계산해서 넣고 싶다면)
  change    Decimal? @db.Decimal(5, 2)  // 등락률

  // 빠른 조회를 위한 인덱스 설정
  @@id([ticker, date]) // [핵심] 같은 종목, 같은 날짜 중복 저장 원천 봉쇄
  @@index([date])      // 날짜별 조회 속도 향상
  @@map("daily_stock_prices") // 실제 DB 테이블 이름
}