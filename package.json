{
  "name": "my-stock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "python-api": "run-script-os",
    "python-api:linux": "cd python && ../../.venv/bin/python -m uvicorn stock_api:app --reload --port 8000",
    "python-api:win32": "set PYTHONIOENCODING=utf-8 && cd python && venv\\Scripts\\python -m uvicorn stock_api:app --reload --port 8000",
    "mystock": "concurrently --kill-others \"npm run python-api\" \"npm run dev\"",
    "db:migrate-data": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/plots": "^2.6.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/pretendard": "^5.2.5",
    "@prisma/client": "^6.19.2",
    "antd": "^6.2.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prisma": "^6.19.2",
    "run-script-os": "^1.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
